---
/**
 * MainLayout.astro
 * Base layout with full A11y metadata, Google Fonts, global styles,
 * and fixed navigation.
 */
import Navbar from "../components/Navbar.astro";
import ParticleBackground from "../components/ParticleBackground.astro";
import StatsMonitor from "../components/StatsMonitor.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  initialTheme?: "galaxy" | "dark";
  showThemeSelector?: boolean;
}

const {
  title,
  description = "Skye Ibrahim — Full-Stack Developer & Data Engineer. Building reliable, data-centric systems that prioritize performance, maintainability, and clarity.",
  initialTheme = "dark",
  showThemeSelector = true,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin);
const socialImageUrl = new URL("/og-image.svg", siteOrigin);
---

<!DOCTYPE html>
<html lang="en" data-theme={initialTheme}>
  <head>
    <script is:inline>
      try {
        const tone = sessionStorage.getItem("portfolio-text-tone");
        if (tone === "warm" || tone === "default") {
          document.documentElement.dataset.textTone = tone;
        }
      } catch {}
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={initialTheme === "dark" ? "#121018" : "#000000"} />
    <meta name="color-scheme" content="dark" />
    <meta name="author" content="Skye Ibrahim" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Skye Ibrahim" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Skye Ibrahim — Data Engineer & Software Developer" />

    <!-- Social cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Skye Ibrahim — Data Engineer & Software Developer" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Inter + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="min-h-screen text-slate-200">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    {showThemeSelector && <StatsMonitor />}
    {showThemeSelector && <ParticleBackground />}
    <Navbar showThemeSelector={showThemeSelector} initialTheme={initialTheme} />
    <slot />

    <!-- Vercel Speed Insights & Analytics -->
    <SpeedInsights />
    <Analytics />

    <script>
      import { initializeThemeController } from "../scripts/themeController";

      let cleanupTheme: (() => void) | undefined;
      let cleanupNavigation: (() => void) | undefined;

      const initTheme = () => {
        cleanupTheme?.();
        cleanupTheme = initializeThemeController();
      };

      const initNavigationState = () => {
        cleanupNavigation?.();

        const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".editorial-rail nav a"));
        const sectionLinks = navLinks
          .map((link) => {
            const href = link.getAttribute("href") ?? "";
            const hashIndex = href.indexOf("#");
            if (hashIndex < 0 || href.includes("ads-experience")) return null;
            const id = href.slice(hashIndex + 1);
            const section = document.getElementById(id);
            return section ? { link, section } : null;
          })
          .filter((entry): entry is { link: HTMLAnchorElement; section: HTMLElement } => entry !== null);

        const clearActive = () => {
          navLinks.forEach((link) => {
            link.removeAttribute("data-active-section");
            link.removeAttribute("aria-current");
          });
        };

        if (window.location.pathname.startsWith("/blog")) {
          clearActive();
          const blogLink = navLinks.find((link) => link.getAttribute("href") === "/blog/");
          blogLink?.setAttribute("data-active-section", "true");
          blogLink?.setAttribute("aria-current", "page");
          cleanupNavigation = () => clearActive();
          return;
        }

        if (!sectionLinks.length) return;

        let currentLink: HTMLAnchorElement | undefined;
        const setActive = (active: HTMLAnchorElement) => {
          if (active === currentLink) return;
          clearActive();
          active.setAttribute("data-active-section", "true");
          active.setAttribute("aria-current", "location");
          currentLink = active;
        };

        let frame = 0;
        const updateActiveSection = () => {
          frame = 0;

          // Track the section occupying a stable reading line in the upper third
          // of the viewport. This is deterministic at boundaries and does not
          // depend on how much of two differently-sized sections intersects.
          const readingLine = Math.min(260, Math.max(110, window.innerHeight * 0.32));
          const atPageBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;

          if (atPageBottom) {
            setActive(sectionLinks[sectionLinks.length - 1]!.link);
            return;
          }

          let active = sectionLinks[0]!;
          for (const entry of sectionLinks) {
            const rect = entry.section.getBoundingClientRect();
            if (rect.top <= readingLine) active = entry;
            if (rect.top <= readingLine && rect.bottom > readingLine) {
              active = entry;
              break;
            }
            if (rect.top > readingLine) break;
          }
          setActive(active.link);
        };

        const scheduleUpdate = () => {
          if (frame) return;
          frame = window.requestAnimationFrame(updateActiveSection);
        };

        window.addEventListener("scroll", scheduleUpdate, { passive: true });
        window.addEventListener("resize", scheduleUpdate);
        updateActiveSection();

        cleanupNavigation = () => {
          if (frame) window.cancelAnimationFrame(frame);
          window.removeEventListener("scroll", scheduleUpdate);
          window.removeEventListener("resize", scheduleUpdate);
          currentLink = undefined;
          clearActive();
        };
      };

      const init = () => {
        initTheme();
        initNavigationState();
      };

      document.addEventListener("DOMContentLoaded", init);
      document.addEventListener("astro:page-load", init);
      document.addEventListener("astro:before-swap", () => {
        cleanupTheme?.();
        cleanupNavigation?.();
      });
    </script>

    <style is:global>
      .skip-link {
        position: fixed;
        top: 10px;
        left: 10px;
        z-index: 200;
        padding: 8px 11px;
        border: 1px solid var(--color-accent);
        background: #0c0b10;
        color: var(--color-text-primary);
        font: .68rem var(--font-mono);
        letter-spacing: .04em;
        transform: translateY(calc(-100% - 18px));
        transition: transform 140ms ease;
      }
      .skip-link:focus { transform: none; }

      @media (min-width: 901px) {
        .editorial-rail nav a {
          position: relative;
          transition: color 160ms ease, padding-left 160ms ease;
        }
        .editorial-rail nav a[data-active-section="true"] {
          padding-left: 10px;
          color: var(--color-accent-bright);
        }
        .editorial-rail nav a[data-active-section="true"]::before {
          content: "";
          position: absolute;
          left: 0;
          top: 50%;
          width: 3px;
          height: 3px;
          border-radius: 50%;
          background: var(--color-accent-bright);
          transform: translateY(-50%);
          box-shadow: 0 0 8px var(--color-accent-glow);
        }

        .theme-selector,
        .text-tone-selector {
          border-color: transparent;
          background: transparent;
          opacity: .48;
          transition: opacity 160ms ease, border-color 160ms ease, background-color 160ms ease;
        }
        .theme-selector:hover,
        .theme-selector:focus-within,
        .text-tone-selector:hover,
        .text-tone-selector:focus-within {
          border-color: var(--color-border-dim);
          background: var(--page-background);
          opacity: 1;
        }
        .theme-selector button,
        .text-tone-selector button {
          background: transparent;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .skip-link,
        .editorial-rail nav a,
        .theme-selector,
        .text-tone-selector { transition: none; }
      }
    </style>
  </body>
</html>
