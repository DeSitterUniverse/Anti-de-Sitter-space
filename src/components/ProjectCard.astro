---
import type { Project } from "../data/projects";
import GithubLogoLight from "phosphor-astro/GithubLogoLight.astro";

interface Props { project: Project }
const { project } = Astro.props;
const descriptionParagraphs = project.description.split("\n\n");
---

<article class="project-row">
  <div class="project-heading">
    <h3>{project.title}</h3>
    <p>{project.tech.join(" · ")}</p>
  </div>
  <div class="project-body">
    <p class="project-summary">{project.summary}</p>
    <details class="editorial-details project-description">
      <summary>Details</summary>
      {descriptionParagraphs.map((paragraph) => {
        const linkIndex = project.descriptionLink ? paragraph.indexOf(project.descriptionLink.text) : -1;
        const before = linkIndex >= 0 ? paragraph.slice(0, linkIndex) : paragraph;
        const after = linkIndex >= 0 && project.descriptionLink
          ? paragraph.slice(linkIndex + project.descriptionLink.text.length)
          : "";

        return (
          <p>
            {before}
            {linkIndex >= 0 && project.descriptionLink && (
              <a href={project.descriptionLink.url} target="_blank" rel="noopener noreferrer">{project.descriptionLink.text}</a>
            )}
            {after}
          </p>
        );
      })}
    </details>
    <a class="source-link" href={project.github} target="_blank" rel="noopener noreferrer">
      <GithubLogoLight /> Source
    </a>
  </div>
</article>

<style>
  .project-summary {
    max-width: 760px;
    margin: 0 0 16px;
    color: var(--color-text-secondary);
    font-size: .98rem;
    line-height: 1.6;
  }
</style>
