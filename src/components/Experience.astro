---

<section id="experience" class="editorial-section">
  <header class="section-heading">
    <h2>Professional Experience &amp; Education</h2>
  </header>

  <div class="experience-list">
    {experiences.map((item) => (
      <article class="experience-row">
        <div class="experience-meta">
          <h3>{item.organization}</h3>
          <time>{item.period}</time>
        </div>
        <div class="experience-content">
          {item.type === "work" ? item.roles?.map((role) => (
            <div class="role-row">
              <h4>{role.title}</h4>
              <p class="role-team">{role.team}</p>
              <p>{role.description}</p>
              <details class="editorial-details">
                <summary>Details</summary>
                <ul>{role.details.map((detail) => <li>{detail}</li>)}</ul>
              </details>
            </div>
          )) : (
            <div class="role-row">
              <h4>{item.title}</h4>
              <ul class="education-details">{item.details?.map((detail) => <li>{detail}</li>)}</ul>
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>
